{
  "name": "aitor-hub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "validate": "node scripts/validate-catalog.mjs",
    "check-links": "node scripts/check-links.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run validate && tsc --noEmit && vite build && vite build --ssr entry-server.tsx --outDir .ssr && node scripts/prerender.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "lucide-react": "^1.59.0",
    "react": "^19.2.0",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
